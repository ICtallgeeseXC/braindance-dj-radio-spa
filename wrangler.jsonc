{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p2p-radio",
  "main": "worker/relay-worker.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "P2P_RELAY",
        "class_name": "P2PRelayDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["P2PRelayDO"]
    }
  ]
}
